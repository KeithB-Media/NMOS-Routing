# NMOS Routing — server configuration (copy to .env; .env is git-ignored)

# Listen address and port for the operator UI.
HOST=127.0.0.1
PORT=8194

# demo: generated in-memory facility, no network access, routing changes only local state.
# live: start the nmos-crosspoint engine in-process and route real IS-05 receivers.
ROUTING_MODE=demo

# Live mode: static NMOS registry (IS-04 Query API host). Leave empty to rely on
# unicast DNS-SD / mDNS discovery. Only used to seed a fresh engine settings.json;
# afterwards edit ${DATA_DIR}/engine/config/settings.json or use the Setup page.
NMOS_REGISTRY=
NMOS_REGISTRY_PORT=80

# Live mode starts read-only. Set true once you have validated the inventory.
WRITE_ENABLED=false

# Where local metadata (tags, favorites, activity) and the engine's config/state live.
DATA_DIR=./data
# Engine directory (config/settings.json, state/*.json). Defaults to ${DATA_DIR}/engine.
ENGINE_DIR=
# Mirror the engine log to the console.
ENGINE_LOG=false

# Optional operator HTTP Basic authentication.
UI_USERNAME=operator
UI_PASSWORD=

# Only /embed can be framed by these exact parent origins (comma separated).
EMBED_ALLOWED_ORIGINS=
# Set true for RAM-only deployments so the UI labels tags as non-persistent.
EPHEMERAL_STATE=false
